<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0201" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <fileHeader companyName="Example Water Co." productName="CODESYS" productVersion="CODESYS V3.5 SP19" creationDateTime="2026-11-16T09:00:00"/>
  <contentHeader name="PumpStation" modificationDateTime="2026-11-16T09:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes>
      <dataType name="E_PumpState">
        <baseType>
          <enum>
            <values>
              <value name="Idle" value="0"/>
              <value name="Running" value="1"/>
              <value name="Faulted" value="2"/>
            </values>
          </enum>
        </baseType>
      </dataType>
      <dataType name="ST_Pump">
        <baseType>
          <struct>
            <variable name="State"><type><derived name="E_PumpState"/></type></variable>
            <variable name="Speed"><type><REAL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Speed in percent</xhtml></documentation>
            </variable>
            <variable name="Hours"><type><UDINT/></type></variable>
          </struct>
        </baseType>
      </dataType>
    </dataTypes>
    <pous>
      <pou name="FB_Pump" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="xEnable"><type><BOOL/></type></variable>
            <variable name="rLevel"><type><REAL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Tank level in m</xhtml></documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="xRun"><type><BOOL/></type></variable>
          </outputVars>
          <localVars constant="true">
            <variable name="START_LEVEL"><type><REAL/></type><initialValue><simpleValue value="2.5"/></initialValue></variable>
            <variable name="STOP_LEVEL"><type><REAL/></type><initialValue><simpleValue value="0.8"/></initialValue></variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">IF NOT xEnable THEN
    xRun := FALSE;
ELSIF rLevel &gt; START_LEVEL THEN
    xRun := TRUE;
ELSIF rLevel &lt; STOP_LEVEL THEN
    xRun := FALSE;
END_IF</xhtml>
          </ST>
        </body>
        <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Level-controlled pump with hysteresis</xhtml></documentation>
      </pou>
      <pou name="PLC_PRG" pouType="program">
        <interface>
          <localVars>
            <variable name="fbPump1"><type><derived name="FB_Pump"/></type></variable>
            <variable name="aLevels"><type><array><dimension lower="1" upper="4"/><baseType><REAL/></baseType></array></type></variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">fbPump1(xEnable := GVL.xAuto, rLevel := aLevels[1]);
GVL.xPump1Run := fbPump1.xRun;</xhtml>
          </ST>
        </body>
      </pou>
      <pou name="Alarms" pouType="program">
        <interface>
          <localVars>
            <variable name="xHighLevel"><type><BOOL/></type></variable>
          </localVars>
        </interface>
        <body>
          <LD>
            <leftPowerRail localId="1" height="40" width="3"><position x="10" y="10"/><connectionPointOut formalParameter=""/></leftPowerRail>
            <contact localId="2" negated="false" height="15" width="21"><position x="50" y="20"/><connectionPointIn><connection refLocalId="1"/></connectionPointIn><connectionPointOut/><variable>GVL.xLevelHighSwitch</variable></contact>
            <coil localId="3" negated="false" height="15" width="21"><position x="150" y="20"/><connectionPointIn><connection refLocalId="2"/></connectionPointIn><connectionPointOut/><variable>xHighLevel</variable></coil>
            <rightPowerRail localId="4" height="40" width="3"><position x="200" y="10"/><connectionPointIn><connection refLocalId="3"/></connectionPointIn></rightPowerRail>
          </LD>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations>
      <configuration name="Device">
        <resource name="Application">
          <task name="MainTask" interval="T#20ms" priority="1">
            <pouInstance name="PLC_PRG" typeName="PLC_PRG"/>
            <pouInstance name="Alarms" typeName="Alarms"/>
          </task>
          <globalVars name="GVL">
            <variable name="xAuto"><type><BOOL/></type><initialValue><simpleValue value="TRUE"/></initialValue></variable>
            <variable name="xPump1Run" address="%QX0.0"><type><BOOL/></type></variable>
            <variable name="xLevelHighSwitch" address="%IX0.3"><type><BOOL/></type></variable>
          </globalVars>
        </resource>
      </configuration>
    </configurations>
  </instances>
</project>
