<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Start/stop seal-in for the infeed conveyor]]>
</Comment>
<Text>
<![CDATA[[XIC(StartPB) ,XIC(Running) ]XIC(StopPB)XIO(EStop)OTE(Running);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Running)OTE(Conveyor1.Run);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Jam detection: photo eye blocked for 5 s]]>
</Comment>
<Text>
<![CDATA[XIC(Running)XIC(PhotoEye)TON(JamDelay,?,?);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(JamDelay.DN)OTL(Conveyor1.Fault);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Sound the horn while the conveyor is faulted]]>
</Comment>
<Text>
<![CDATA[XIC(Conveyor1.Fault)OTE(Horn);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[JSR(SpeedCalc,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SpeedCalc" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// Ramp the conveyor speed setpoint]]>
</Line>
<Line Number="1">
<![CDATA[IF Running THEN]]>
</Line>
<Line Number="2">
<![CDATA[    Conveyor1.Speed := 15.0;  // faster line after gearbox change]]>
</Line>
<Line Number="3">
<![CDATA[ELSE]]>
</Line>
<Line Number="4">
<![CDATA[    Conveyor1.Speed := 0.0;]]>
</Line>
<Line Number="5">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
<ScheduledPrograms>
<ScheduledProgram Name="MainProgram"/>
</ScheduledPrograms>
</Task>
</Tasks>
